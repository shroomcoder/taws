# TAWS MariaDB Configuration
# Generated by TAWS

[mysqld]
# Basic Settings
user = {{.User}}
datadir = {{.DataDir}}
socket = {{.SocketDir}}/mysql.sock
pid-file = {{.PIDFile}}

# Network
bind-address = {{.BindAddress}}
port = {{.Port}}
skip-networking = 0

# Logging
log-error = {{.LogDir}}/mariadb-error.log
slow-query-log = 1
slow-query-log-file = {{.LogDir}}/mariadb-slow.log
long_query_time = 2

# InnoDB
innodb_buffer_pool_size = {{.BufferPoolSize}}
innodb_log_file_size = {{.LogFileSize}}
innodb_flush_log_at_trx_commit = 1
innodb_file_per_table = 1

# Character Set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Security
local-infile = 0
symbolic-links = 0

# Performance
max_connections = {{.MaxConnections}}
max_allowed_packet = {{.MaxAllowedPacket}}
table_open_cache = 256
tmp_table_size = 32M
max_heap_table_size = 32M

[client]
socket = {{.SocketDir}}/mysql.sock
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
