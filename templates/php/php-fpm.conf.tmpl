; TAWS PHP-FPM Pool Configuration
; Generated by TAWS

[{{.Name}}]
user = {{.User}}
group = {{.Group}}

listen = 127.0.0.1:{{.Port}}

pm = dynamic
pm.max_children = {{.MaxChildren}}
pm.start_servers = {{.StartServers}}
pm.min_spare_servers = {{.MinSpareServers}}
pm.max_spare_servers = {{.MaxSpareServers}}
pm.max_requests = {{.MaxRequests}}

slowlog = {{.LogDir}}/php-fpm-slow.log
request_slowlog_timeout = 5s

php_admin_value[error_log] = {{.LogDir}}/php-fpm-error.log
php_admin_flag[log_errors] = on

php_value[upload_max_filesize] = {{.UploadMaxFilesize}}
php_value[post_max_size] = {{.PostMaxSize}}
php_value[memory_limit] = {{.MemoryLimit}}
php_value[max_execution_time] = {{.MaxExecutionTime}}
php_value[max_input_time] = {{.MaxInputTime}}
